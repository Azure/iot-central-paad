{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "jsx": "react-native",
    "lib": ["es2022"],
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "target": "es2022",
    "skipLibCheck": true,
    "paths": {
      "*": ["./src/*"],
      "tools/*": ["./src/tools/*"],
      "hooks/*": ["./src/hooks/*"],
      "properties/*": ["./src/properties/*"],
      "contexts/*": ["./src/contexts/*"],
      "sensors/*": ["./src/sensors/*"],
      "components/*": ["./src/components/*"],
      "types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "src/sensors/health/**/*.ts*",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "creds-generator"
  ]
}
